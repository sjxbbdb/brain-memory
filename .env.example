# Brain Memory v8.0 — Environment Configuration
# Copy this file to .env and fill in your API keys

# DeepSeek V3 (primary LLM, required)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DashScope (text embeddings, required)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# GLM-4 (fallback LLM, optional)
GLM_API_KEY=
