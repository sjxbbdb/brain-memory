# Brain Memory v4.1 — Environment Configuration
# Copy this file to .env and fill in your API keys

# DeepSeek V3 (primary LLM, required)
DEEPSEEK_API_KEY=your-deepseek-key-here

# DashScope (text embeddings, required)
DASHSCOPE_API_KEY=your-dashscope-key-here

# GLM-4 (fallback LLM, optional — currently unused in v4.1)
GLM_API_KEY=your-glm-key-here
