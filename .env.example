# Brain Memory v10.0 — Environment Configuration
# Copy this file to .env and fill in your API keys

# DeepSeek V3 (primary LLM, required)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DashScope (text embeddings, required)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# GLM-4 (fallback LLM, optional)
GLM_API_KEY=

# Verifiable information sources (no search-provider key required)
# Default: official Wikipedia JSON API. Add arxiv and/or feeds when needed.
BRAIN_MEMORY_SOURCE_PROVIDERS=wikipedia
BRAIN_MEMORY_SOURCE_WIKIPEDIA_LANGS=zh,en
# Comma-separated HTTPS RSS/Atom URLs; use {query} only for a documented query feed.
# BRAIN_MEMORY_SOURCE_FEEDS=
BRAIN_MEMORY_SOURCE_TIMEOUT_SEC=8
BRAIN_MEMORY_SOURCE_CACHE_TTL_SEC=60

# Set to 1 for a fully offline run (source results become simulated).
# BRAIN_MEMORY_OFFLINE=1

# Hard limit for retrieval/LLM work inside one heartbeat.  A timeout falls
# back to a local think-only result so the heartbeat can keep running.
BRAIN_MEMORY_COGNITIVE_TIMEOUT_SEC=10

# Long-term task policy (one execution lane; bounded tiered queue)
BRAIN_MEMORY_TASK_QUEUE_LIMIT=12
BRAIN_MEMORY_TASK_MAINTENANCE_BUDGET_TICKS=60
BRAIN_MEMORY_TASK_USER_BUDGET_TICKS=120
BRAIN_MEMORY_TASK_EXPLORATION_BUDGET_TICKS=90
BRAIN_MEMORY_TASK_MAINTENANCE_DEADLINE_TICKS=180
BRAIN_MEMORY_TASK_USER_DEADLINE_TICKS=360
BRAIN_MEMORY_TASK_EXPLORATION_DEADLINE_TICKS=240

# V13 bounded execution ledger (deterministic verification; no automatic
# side-effect writes).  Unknown/simulated outcomes never complete a task.
BRAIN_MEMORY_TASK_EXECUTION_ENABLED=1
BRAIN_MEMORY_TASK_EXECUTION_MAX_PLANS=32
BRAIN_MEMORY_TASK_EXECUTION_MAX_STEPS=8
BRAIN_MEMORY_TASK_EXECUTION_MAX_DEPTH=3
BRAIN_MEMORY_TASK_EXECUTION_MAX_RETRIES=2
BRAIN_MEMORY_TASK_EXECUTION_MAX_ACTIONS=128
BRAIN_MEMORY_TASK_EXECUTION_MAX_OBSERVATIONS=128
BRAIN_MEMORY_TASK_EXECUTION_MAX_OUTCOMES=128
BRAIN_MEMORY_TASK_EXECUTION_MAX_EVENTS=256
BRAIN_MEMORY_TASK_EXECUTION_REQUIRE_VERIFIED_COMPLETION=1
BRAIN_MEMORY_TASK_EXECUTION_AUTO_REPLAN=0
